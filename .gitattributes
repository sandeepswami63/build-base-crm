# Strictly enforce LF (Line Feed) for all text files to prevent Windows/Linux conflicts
* text=auto eol=lf

# Explicitly handle common file types
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Build and configuration files
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env* text eol=lf

# Script files
*.sh text eol=lf
*.bash text eol=lf

# Binary files (git will treat them as binary and won't touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.svg text eol=lf
